<?xml version="1.0" encoding="UTF-8"?>
<!--
  mac-ownerapp-verify — iOS Simulator verification.

  03:00 ET nightly, after the voice window. Boots owner-app branches in the iOS
  Simulator and proves no claimant data is reachable from that surface.

  Paths are placeholders substituted by scripts/install_mac_loops.sh at install
  time, so no absolute home path is committed.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.thecompdesk.os.ownerapp-verify</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>__DESK_REPO__/scripts/mac_loop.sh ownerapp-verify-mac</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <!-- Audio and the event tap need the GUI session. -->
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>

  <key>ProcessType</key>
  <string>Standard</string>

  <!-- A verify run that overruns its window is a bug, not a long night. Five
       hours is the whole window; past that it is wedged and should be killed
       rather than left holding the microphone into Joel's morning. -->
  <key>ExitTimeOut</key>
  <integer>14400</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__DESK_LOGS__/ownerapp-verify.out.log</string>
  <key>StandardErrorPath</key>
  <string>__DESK_LOGS__/ownerapp-verify.err.log</string>
</dict>
</plist>
