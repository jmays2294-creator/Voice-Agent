@@ -0,0 +1,364 @@
+import { useCallback, useEffect, useRef, useState, type ReactNode } from 'react'
+import { Card, StatTile, SectionTitle } from '@/design-system/primitives/Card'
+import { Badge } from '@/design-system/primitives/Badge'
+import {
+  ADVERSARIAL_RULES, fetchVoiceMetrics, ruleLabel,
+  type VoiceMetrics, type VoiceWindow,
+} from '@/lib/voiceMetrics'
+
+// Voice section of the Owner Dashboard. Self-contained: it owns its single RPC
+// and its own poll, so the rest of the screen is unaffected if the voice daemon
+// or its tables are not deployed yet.
+//
+// Reading order is deliberate and is not the order the data happens to arrive
+// in. Is it alive; is anything trying things it should not; is it inside the
+// latency contract; what did it change. A dashboard that leads with latency
+// buries the sentence that matters.
+
+const POLL_MS = 30_000
+
+/** The contract is measured over twenty turns; below that, say so. */
+const MIN_TURNS_FOR_A_VERDICT = 20
+
+export function VoiceSection({ win }: { win: VoiceWindow }) {
+  const [data, setData] = useState<VoiceMetrics | null>(null)
+  const [err, setErr] = useState<string | null>(null)
+  const winRef = useRef(win)
+  const inFlight = useRef(false)
+
+  const load = useCallback(async (w: VoiceWindow) => {
+    if (inFlight.current) return
+    inFlight.current = true
+    try {
+      const d = await fetchVoiceMetrics(w)
+      if (w !== winRef.current) return // window changed mid-flight; discard
+      setErr(null)
+      setData(d)
+    } catch (e) {
+      // FAIL LOUD, and keep whatever was last on screen, marked stale.
+      if (w === winRef.current) setErr(e instanceof Error ? e.message : String(e))
+    } finally {
+      inFlight.current = false
+    }
+  }, [])
+
+  useEffect(() => {
+    winRef.current = win
+    void load(win)
+    const id = setInterval(() => {
+      if (document.visibilityState === 'hidden') return
+      void load(win)
+    }, POLL_MS)
+    const onVis = () => { if (document.visibilityState === 'visible') void load(win) }
+    document.addEventListener('visibilitychange', onVis)
+    return () => {
+      clearInterval(id)
+      document.removeEventListener('visibilitychange', onVis)
+    }
+  }, [win, load])
+
+  if (err && !data) {
+    return (
+      <>
+        <SectionTitle>Voice</SectionTitle>
+        <Card className="p-4 border-danger/40">
+          <div className="text-danger text-sm font-medium">Voice metrics fetch failed: {err}</div>
+          <div className="text-xs text-ink-muted mt-1">
+            If this reads “function voice_dashboard_metrics does not exist”, the voice
+            migrations have not been applied yet. Any other error is real — it is not
+            the same as the daemon being quiet.
+          </div>
+        </Card>
+      </>
+    )
+  }
+
+  if (!data) {
+    return (
+      <>
+        <SectionTitle>Voice</SectionTitle>
+        <Card className="p-5 animate-pulse" aria-busy="true" aria-label="Loading voice metrics">
+          <div className="h-3 w-24 rounded-sm bg-surface-sink" />
+          <div className="h-8 w-40 rounded-sm bg-surface-sink mt-3" />
+        </Card>
+      </>
+    )
+  }
+
+  const { latency, actions, last_session: last } = data
+  const adversarial = Object.entries(data.refusals_by_rule)
+    .filter(([rule]) => ADVERSARIAL_RULES.has(rule))
+    .reduce((n, [, count]) => n + count, 0)
+  const enoughTurns = latency.turns >= MIN_TURNS_FOR_A_VERDICT
+  const p50Verdict = latency.p50_ms == null ? null
+    : latency.p50_ms <= latency.budget_p50_ms
+
+  return (
+    <>
+      <SectionTitle>Voice</SectionTitle>
+
+      {err && (
+        <Card className="p-3 mb-3 border-danger/40">
+          <div className="text-danger text-xs">
+            Refresh failed ({err}). Showing the last good read.
+          </div>
+        </Card>
+      )}
+
+      <LastSessionStrip last={last} />
+
+      <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
+        <StatTile
+          label={`p50 · ${data.window}`}
+          value={ms(latency.p50_ms)}
+          accent={p50Verdict === false}
+          sub={
+            latency.p50_ms == null ? 'no turns in this window'
+              : `${p50Verdict ? 'within' : 'over'} the ${latency.budget_p50_ms}ms contract` +
+                (enoughTurns ? '' : ` · only ${latency.turns} turn${latency.turns === 1 ? '' : 's'}`)
+          }
+        />
+        <StatTile
+          label="p95"
+          value={ms(latency.p95_ms)}
+          sub={latency.p95_ms == null ? '—' : `budget ${latency.budget_p95_ms}ms`}
+        />
+        <StatTile
+          label="Refused actions"
+          value={actions.refused}
+          accent={adversarial > 0}
+          sub={
+            actions.refused === 0 ? 'nothing was refused'
+              : adversarial > 0
+                ? `${adversarial} reached for something dangerous`
+                : 'all routine — capabilities it does not have'
+          }
+        />
+        <StatTile
+          label="Voice approvals"
+          value={actions.approvals}
+          sub={
+            actions.high_risk_approvals > 0
+              ? `${actions.high_risk_approvals} high risk`
+              : `${actions.rejections} rejected · ${actions.defers} deferred`
+          }
+        />
+      </div>
+
+      <div className="grid md:grid-cols-2 gap-4 mb-4">
+        <Card className="p-5">
+          <div className="flex items-baseline justify-between mb-3">
+            <div className="text-sm font-medium text-ink-soft">Latency by stage</div>
+            <div className="text-xs text-ink-muted font-numeric">
+              {latency.turns} turn{latency.turns === 1 ? '' : 's'}
+            </div>
+          </div>
+          {latency.turns === 0 ? (
+            <p className="text-xs text-ink-muted">No turns in this window.</p>
+          ) : (
+            <StageBars latency={latency} />
+          )}
+          {latency.turns > 0 && !enoughTurns && (
+            <p className="text-xs text-ink-muted mt-3">
+              The contract is measured over twenty turns. Fewer than that is a reading,
+              not a verdict.
+            </p>
+          )}
+          {(latency.barge_ins > 0 || latency.rebuilds > 0) && (
+            <div className="flex flex-wrap gap-2 mt-3">
+              {latency.barge_ins > 0 && <Badge tone="navy">{latency.barge_ins} barge-ins</Badge>}
+              {latency.rebuilds > 0 && (
+                <Badge tone={latency.rebuilds > latency.barge_ins ? 'warn' : 'muted'}>
+                  {latency.rebuilds} session rebuilds
+                </Badge>
+              )}
+            </div>
+          )}
+          {latency.rebuilds > latency.barge_ins && (
+            <p className="text-xs text-ink-muted mt-2">
+              More rebuilds than barge-ins means the drain is timing out on its own.
+              That is the shared-stream path failing, not the user interrupting.
+            </p>
+          )}
+        </Card>
+
+        <Card className="p-5">
+          <div className="flex items-baseline justify-between mb-3">
+            <div className="text-sm font-medium text-ink-soft">Refusals by rule</div>
+            {adversarial > 0 && <Badge tone="danger">{adversarial} adversarial</Badge>}
+          </div>
+          {Object.keys(data.refusals_by_rule).length === 0 ? (
+            <p className="text-xs text-ink-muted">
+              Nothing was refused in this window. That is the quiet case, not a missing feed —
+              refusals only appear when the agent reaches for something it cannot have.
+            </p>
+          ) : (
+            <>
+              <RuleBars data={data.refusals_by_rule} />
+              <p className="text-xs text-ink-muted mt-3">
+                Every refusal was also spoken aloud
+                {actions.refused > 0 && actions.refusals_spoken < actions.refused && (
+                  <> — except {actions.refused - actions.refusals_spoken}, which were not</>
+                )}
+                . Red rules mean something tried a dangerous verb; grey is the agent
+                reaching for a capability it does not have, which is routine.
+              </p>
+            </>
+          )}
+        </Card>
+      </div>
+
+      <Card className="p-5">
+        <div className="text-sm font-medium text-ink-soft mb-3">Actions taken</div>
+        {Object.keys(data.by_action).length === 0 ? (
+          <p className="text-xs text-ink-muted">No actions in this window.</p>
+        ) : (
+          <>
+            <RuleBars data={data.by_action} tone="orange" />
+            <div className="flex flex-wrap gap-2 mt-3">
+              <Badge tone="muted">{actions.reads} reads</Badge>
+              <Badge tone="navy">{actions.approvals} approved</Badge>
+              {actions.high_risk_approvals > 0 && (
+                <Badge tone="orange">{actions.high_risk_approvals} high risk</Badge>
+              )}
+            </div>
+          </>
+        )}
+      </Card>
+    </>
+  )
+}
+
+/** The first thing worth knowing: is it alive, and did the last run close cleanly? */
+function LastSessionStrip({ last }: { last: VoiceMetrics['last_session'] }) {
+  if (!last) {
+    return (
+      <Card className="p-4 mb-4">
+        <div className="text-sm text-ink-soft">
+          No voice session has ever been recorded. If the daemon is installed, it has
+          not completed a session — check <span className="font-numeric">launchctl list
+          com.thecompdesk.desk</span> on the Mac.
+        </div>
+      </Card>
+    )
+  }
+
+  // A row still marked running after six hours is a silent failure, not a long
+  // job. It is the loudest thing this section can say.
+  if (last.stale) {
+    return (
+      <Card className="p-4 mb-4 border-danger/40">
+        <div className="flex items-center gap-2 mb-1">
+          <Badge tone="danger">Silent failure</Badge>
+          <span className="text-sm font-medium text-danger">
+            A session has been marked running for {formatAge(last.age_minutes)}.
+          </span>
+        </div>
+        <div className="text-xs text-ink-soft">
+          The row was never closed. That is a crashed or wedged daemon, not a long
+          conversation — “nothing to report” and “nothing ran” are different answers.
+        </div>
+      </Card>
+    )
+  }
+
+  const failed = last.status === 'failed'
+  return (
+    <Card className={`p-4 mb-4 ${failed ? 'border-danger/40' : ''}`}>
+      <div className="flex items-center gap-2 flex-wrap">
+        <Badge tone={failed ? 'danger' : last.status === 'running' ? 'navy' : 'success'}>
+          {last.status}
+        </Badge>
+        <span className="text-sm text-ink">
+          Last session {formatAge(last.age_minutes)} ago
+        </span>
+        <span className="text-sm text-ink-muted">
+          · {last.turns} turn{last.turns === 1 ? '' : 's'}
+        </span>
+      </div>
+      {failed && last.notes && (
+        <div className="text-xs text-danger mt-1.5">{last.notes}</div>
+      )}
+    </Card>
+  )
+}
+
+function StageBars({ latency }: { latency: VoiceMetrics['latency'] }) {
+  // Budgets from the daemon's config/desk.toml. A stage over budget is the pole
+  // to pull on, which a single end-to-end number never tells you.
+  const stages: { label: string; value: number | null; budget: number }[] = [
+    { label: 'Transcribe', value: latency.transcribe_p50_ms, budget: 200 },
+    { label: 'First token', value: latency.first_token_p50_ms, budget: 600 },
+    { label: 'First sentence', value: latency.first_sentence_p50_ms, budget: 350 },
+    { label: 'First audio', value: latency.first_audio_p50_ms, budget: 80 },
+  ]
+  const scale = Math.max(1, ...stages.map((s) => Math.max(s.value ?? 0, s.budget)))
+  return (
+    <div className="grid gap-2">
+      {stages.map((s) => {
+        const over = s.value != null && s.value > s.budget
+        return (
+          <div key={s.label} className="flex items-center gap-2 text-xs">
+            <span className="w-28 truncate text-ink-soft">{s.label}</span>
+            <div className="flex-1 h-3 rounded-sm bg-surface-sink overflow-hidden relative">
+              <div
+                className={`h-full rounded-sm ${over ? 'bg-danger' : 'bg-success'}`}
+                style={{ width: `${((s.value ?? 0) / scale) * 100}%` }}
+              />
+              <div
+                className="absolute top-0 h-full w-px bg-ink-muted/60"
+                style={{ left: `${(s.budget / scale) * 100}%` }}
+                title={`budget ${s.budget}ms`}
+              />
+            </div>
+            <span className={`w-14 text-right font-numeric ${over ? 'text-danger' : 'text-ink'}`}>
+              {ms(s.value)}
+            </span>
+          </div>
+        )
+      })}
+      <p className="text-[11px] text-ink-muted mt-1">
+        The hairline on each bar is that stage’s budget.
+      </p>
+    </div>
+  )
+}
+
+function RuleBars({ data, tone = 'rule' }: {
+  data: Record<string, number>; tone?: 'rule' | 'orange'
+}) {
+  const entries = Object.entries(data).sort((a, b) => b[1] - a[1])
+  const max = Math.max(1, ...entries.map(([, n]) => n))
+  return (
+    <div className="grid gap-1.5">
+      {entries.map(([key, n]) => {
+        const bad = tone === 'rule' && ADVERSARIAL_RULES.has(key)
+        return (
+          <div key={key} className="flex items-center gap-2 text-xs">
+            <span className={`w-40 truncate ${bad ? 'text-danger' : 'text-ink-soft'}`} title={key}>
+              {tone === 'rule' ? ruleLabel(key) : key}
+            </span>
+            <div className="flex-1 h-3 rounded-sm bg-surface-sink overflow-hidden">
+              <div
+                className={`h-full rounded-sm ${bad ? 'bg-danger' : tone === 'orange' ? 'bg-orange/70' : 'bg-ink-muted/40'}`}
+                style={{ width: `${(n / max) * 100}%` }}
+              />
+            </div>
+            <span className="w-8 text-right font-numeric text-ink">{n}</span>
+          </div>
+        )
+      })}
+    </div>
+  )
+}
+
+const ms = (n: number | null | undefined): ReactNode =>
+  n == null ? '—' : `${n.toLocaleString()}ms`
+
+function formatAge(minutes: number): string {
+  if (minutes < 1) return 'less than a minute'
+  if (minutes < 60) return `${minutes} minute${minutes === 1 ? '' : 's'}`
+  const hours = Math.round(minutes / 60)
+  if (hours < 48) return `${hours} hour${hours === 1 ? '' : 's'}`
+  return `${Math.round(hours / 24)} days`
+}
