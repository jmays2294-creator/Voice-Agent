@@ -0,0 +1,119 @@
+import { supabase } from './supabase'
+
+// Voice section of the owner dashboard. Single data source: the
+// voice_dashboard_metrics RPC — SECURITY DEFINER, gated server-side by
+// is_owner(), same shape as owner_dashboard_metrics (087). The nav and route
+// guard are cosmetic; the RPC's 42501 is the real boundary.
+// NO direct table reads from this section, ever.
+//
+// Everything below is a count, a millisecond figure, or a rule name. The
+// daemon never ships a transcript — voice_turns has no text column at all —
+// so there is nothing on this screen that could be case material.
+
+export type VoiceWindow = 'today' | '7d' | '30d' | 'all'
+
+/** The latency contract, mirrored from the daemon's config/desk.toml. */
+export const CONTRACT = { p50: 1200, p95: 1800 } as const
+
+export interface VoiceLastSession {
+  at: string
+  finished_at: string | null
+  status: string
+  notes: string | null
+  turns: number
+  age_minutes: number
+  /** A run still marked running after six hours is a silent failure. */
+  stale: boolean
+}
+
+export interface VoiceMetrics {
+  window: string
+  generated_at: string
+  last_session: VoiceLastSession | null
+  sessions: { total: number; passed: number; failed: number; stalled: number }
+  latency: {
+    turns: number
+    p50_ms: number | null
+    p95_ms: number | null
+    budget_p50_ms: number
+    budget_p95_ms: number
+    transcribe_p50_ms: number | null
+    first_token_p50_ms: number | null
+    first_sentence_p50_ms: number | null
+    first_audio_p50_ms: number | null
+    barge_ins: number
+    rebuilds: number
+  }
+  actions: {
+    allowed: number
+    refused: number
+    reads: number
+    approvals: number
+    rejections: number
+    defers: number
+    high_risk_approvals: number
+    refusals_spoken: number
+  }
+  by_action: Record<string, number>
+  refusals_by_rule: Record<string, number>
+}
+
+export async function fetchVoiceMetrics(win: VoiceWindow): Promise<VoiceMetrics> {
+  const { data, error } = await supabase.rpc('voice_dashboard_metrics', { p_window: win })
+  if (error) {
+    // FAIL LOUD. A swallowed 42501 rendered as zeros would read as "the voice
+    // agent did nothing today", which is indistinguishable from "the voice
+    // agent is dead" and from "you lost owner access". Never zero-fill.
+    // eslint-disable-next-line no-console
+    console.error('[admin] VOICE_METRICS_FETCH_FAILED', error)
+    throw new Error(error.message)
+  }
+  return data as VoiceMetrics
+}
+
+/** Human label for a guard rule id, e.g. bash.forbidden_verb. */
+export function ruleLabel(rule: string): string {
+  return RULE_LABELS[rule] ?? rule
+}
+
+/**
+ * Rules that mean something actively tried a dangerous verb, as opposed to the
+ * agent reaching for a capability it does not have. The distinction matters:
+ * the first group is the injection signal and is worth looking at; the second
+ * is routine and is what deny-by-default sounds like in normal use.
+ */
+export const ADVERSARIAL_RULES = new Set([
+  'bash.forbidden_verb',
+  'bash.protected_ref',
+  'bash.metacharacter',
+  'read.secret',
+  'write.secret',
+  'write.outside_scratch',
+  'net.host_not_granted',
+  'action.unknown',
+  'session.unexpected_mode',
+  'guard.internal_error',
+])
+
+const RULE_LABELS: Record<string, string> = {
+  'bash.forbidden_verb': 'Forbidden command',
+  'bash.protected_ref': 'Tried to touch main',
+  'bash.metacharacter': 'Shell syntax',
+  'bash.not_an_action': 'Not a named action',
+  'bash.background': 'Background command',
+  'read.secret': 'Reached for a credential',
+  'read.outside_workspace': 'Read outside the workspace',
+  'write.secret': 'Write at a credential path',
+  'write.outside_scratch': 'Write outside scratch',
+  'net.no_grant': 'Web without a grant',
+  'net.no_search': 'Web search',
+  'net.host_not_granted': 'Web host not granted',
+  'net.grant_expired': 'Web grant lapsed',
+  'action.unknown': 'Unknown action',
+  'action.bad_arguments': 'Bad arguments',
+  'tool.mcp': 'Connected service, direct',
+  'tool.fanout': 'Tried to start a sub-agent',
+  'tool.unknown': 'Capability it does not have',
+  'session.unexpected_mode': 'Unexpected permission mode',
+  'guard.internal_error': 'Guard could not evaluate',
+}
